  {
   "type": "stat",
   "title": "Prometheus scrape targets (mms-*)",
   "datasource": {
    "type": "prometheus",
    "uid": "mms-prom"
   },
   "gridPos": {
    "h": 5,
    "w": 24,
    "x": 0,
    "y": 21
   },
   "options": {
    "colorMode": "background",
    "textMode": "value_and_name",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "UP",
         "color": "green"
        },
        "0": {
         "text": "DOWN",
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=~\"mms-.*\"}",
     "legendFormat": "{{job}}",
     "datasource": {
      "type": "prometheus",
      "uid": "mms-prom"
     }
    }
   ]
  },
