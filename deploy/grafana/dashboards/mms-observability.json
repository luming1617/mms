{
 "uid": "mms-observability",
 "title": "MMS Observability - Golden Signals",
 "tags": [
  "mms",
  "observability"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "API availability (5m ratio)",
   "datasource": {
    "type": "prometheus",
    "uid": "mms-prom"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "mms:query_availability:ratio_rate5m",
     "legendFormat": "availability",
     "datasource": {
      "type": "prometheus",
      "uid": "mms-prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Traffic: RPS by route template",
   "datasource": {
    "type": "prometheus",
    "uid": "mms-prom"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(mms_api_requests_total[5m]))",
     "legendFormat": "{{route}}",
     "datasource": {
      "type": "prometheus",
      "uid": "mms-prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Errors: 5xx ratio by route",
   "datasource": {
    "type": "prometheus",
    "uid": "mms-prom"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 0
