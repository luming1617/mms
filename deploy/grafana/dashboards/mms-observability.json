    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(mms_api_requests_total{code=~\"5..\"}[5m])) / sum by (route) (rate(mms_api_requests_total[5m]))",
     "legendFormat": "{{route}}",
     "datasource": {
      "type": "prometheus",
      "uid": "mms-prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Latency: P95 by route template",
   "datasource": {
    "type": "prometheus",
    "uid": "mms-prom"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
