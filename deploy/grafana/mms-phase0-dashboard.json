{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "API availability / latency by path",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "mms:query_availability:ratio_rate5m", "legendFormat": "availability"},
        {"refId": "B", "expr": "mms:query_latency_seconds:p95_default", "legendFormat": "default p95"},
        {"refId": "C", "expr": "mms:query_latency_seconds:p95_extended", "legendFormat": "extended p95"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingestion / Extraction",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "sum by (status) (rate(mms_candidates_total[5m]))", "legendFormat": "candidate {{status}}"},
        {"refId": "B", "expr": "sum by (language) (rate(mms_extraction_parse_failures_total[5m]))", "legendFormat": "parse failure {{language}}"},
        {"refId": "C", "expr": "mms_ingestion_job_oldest_age_seconds", "legendFormat": "oldest ingestion job"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Decision / Conflict / Review",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "sum by (outcome) (rate(mms_decisions_total[5m]))", "legendFormat": "{{outcome}}"},
        {"refId": "B", "expr": "mms_current_conflicts_total", "legendFormat": "oldest open conflict"},
        {"refId": "C", "expr": "rate(mms_candidate_expired_by_sla_total[5m])", "legendFormat": "candidate expired {{from_status}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Embedding Jobs / Provider",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "mms:embedding_ready_age_seconds:p95", "legendFormat": "ready p95 {{view_kind}}"},
        {"refId": "B", "expr": "mms_embedding_job_oldest_age_seconds", "legendFormat": "oldest {{priority_band}}"},
        {"refId": "C", "expr": "sum by (status) (rate(mms_embedding_provider_requests_total[5m]))", "legendFormat": "provider {{status}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Retrieval exact / lexical / RRF",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "mms:vector_search_latency_seconds:p95_exact", "legendFormat": "exact p95"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(mms_vector_search_latency_seconds_bucket[5m])))", "legendFormat": "lexical {{mode}} p95"},
        {"refId": "C", "expr": "rate(mms_retrieval_duplicate_views_collapsed_total[5m])", "legendFormat": "duplicate views collapsed"},
        {"refId": "D", "expr": "mms_retrieval_post_filter_loss_total", "legendFormat": "post filter loss"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Views / multilingual / quality",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "mms_view_count_per_memory_sum", "legendFormat": "ready {{view_kind}}/{{language}}"},
        {"refId": "B", "expr": "mms_view_missing_views", "legendFormat": "missing {{view_kind}}/{{language}}"},
        {"refId": "C", "expr": "mms:translation_ready_age_seconds:p95", "legendFormat": "translation p95 {{target_language}}"},
        {"refId": "D", "expr": "mms_retrieval_recall_at_10", "legendFormat": "Recall@10 {{language}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Deletion / Consistency",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "mms:deletion_completion_seconds:p95", "legendFormat": "deletion p95 {{scope}}"},
        {"refId": "B", "expr": "mms_deletion_completion_seconds_sum", "legendFormat": "oldest deletion"},
        {"refId": "C", "expr": "rate(mms_barrier_write_check_failures_total[5m])", "legendFormat": "barrier check failures"},
        {"refId": "D", "expr": "rate(mms_ddl_guard_rejected_total[5m])", "legendFormat": "guard {{constraint}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka / Outbox / Inbox",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "mms_kafka_consumer_lag_seconds", "legendFormat": "lag {{topic}}/{{group}}"},
        {"refId": "B", "expr": "mms_outbox_oldest_age_seconds", "legendFormat": "oldest outbox"},
        {"refId": "C", "expr": "rate(mms_inbox_stale_total[5m])", "legendFormat": "stale inbox"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Cost / Capacity",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "sum by (model, version) (rate(mms_llm_tokens_total[5m]))", "legendFormat": "embedding tokens {{model}}/{{version}}"},
        {"refId": "B", "expr": "mms_vectors_per_customer_sum", "legendFormat": "storage {{store}}"},
        {"refId": "C", "expr": "mms_retrieval_views_scanned", "legendFormat": "exact scan rows"},
        {"refId": "D", "expr": "mms_view_count_per_memory", "legendFormat": "views per memory"}
      ]
    },
    {
      "type": "stat",
      "title": "Safety counters (all must be zero)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto"},
      "targets": [
        {"refId": "A", "expr": "sum(increase(mms_cross_customer_hits_total[5m]))", "legendFormat": "cross customer"},
        {"refId": "B", "expr": "sum(increase(mms_decision_replay_mismatch_total[5m]))", "legendFormat": "replay mismatch"},
        {"refId": "C", "expr": "sum(increase(mms_current_duplicate_total[5m]))", "legendFormat": "duplicate current"},
        {"refId": "D", "expr": "sum(increase(mms_admin_audit_write_failures_total[5m]))", "legendFormat": "admin audit failure"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mms", "phase0", "slo"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "MMS Phase 0 / SLO",
  "uid": "mms-phase0",
  "version": 1,
  "weekStart": ""
}
