MMS_DATABASE_URL=postgresql://mms:mms@127.0.0.1:5433/mms
MMS_SERVICE_TOKEN=dev-token
MMS_EMBEDDING_PROVIDER=deterministic
MMS_TRANSLATION_TARGET_LANGUAGES=
MMS_TRANSLATION_PROVIDER=
MMS_LEXICAL_ENABLED_LANGUAGES=zh-CN,en-US
MMS_TS_CONFIG_MAP={"en-US":"english"}
MMS_TRGM_FALLBACK_LANGUAGES=zh-CN
MMS_TRANSLATION_PROVIDER_URL=
MMS_TRANSLATION_MAX_TARGET_LANGUAGES=4
MMS_LEXICAL_MODE_MAP={"zh-CN":"trgm","en-US":"fts"}
MMS_LEXICAL_TRGM_THRESHOLD=0.30
MMS_RETRIEVAL_PARALLEL_LEXICAL=true
MMS_RERANKER_ENABLED=false
MMS_RERANKER_URL=
MMS_RERANKER_TIMEOUT_MS=80
MMS_OUTBOX_ENDPOINT=
MMS_DELETION_LEDGER_ENDPOINT=
MMS_DELETION_LEDGER_DIR=/tmp/mms-deletion-ledger
MMS_TRANSLATION_TIMEOUT_MS=1500
MMS_TRANSLATION_MAX_CHARS=4000
MMS_TRANSLATION_BATCH_SIZE=16
MMS_TRANSLATION_QUALITY_THRESHOLD=0.75
MMS_TRANSLATION_LANGUAGE_PRIORITY=
MMS_EXACT_SCAN_SOFT_LIMIT=10000
MMS_READ_REPLICA_ENABLED=false
MMS_READ_REPLICA_DATABASE_URL=
MMS_READ_REPLICA_WRITE_HOLD_SECONDS=5
MMS_AUTHORITY_SYNC_MODE=async
# 摄取新鲜度（docs 10.3.1）：inbox 停在 PROCESSING 超过"重试退避上限 300s + 一个租约"即视为
# worker 失联，mms_inbox_stale_total 计数并告警。
MMS_INBOX_STALE_SECONDS=360
# 摄取主题白名单（docs 10.3）：HTTP 载体上 topic 是网关注入的元数据，未列出的主题直接 422。
MMS_INGESTION_TOPICS=memory-candidates
# 出站通道（docs 12.3）：TLS 强制（development 以外的 http 会在启动时被拒绝）+ 可选服务凭证。
MMS_OUTBOUND_TOKEN=
# 存储加密（docs 12.5）：配置后删除墓碑会记录该 KMS key id，供 crypto-shred 使用。
MMS_KMS_KEY_ID=
# 重排序（docs 11.2/12.2）：只对允许的目的生效，且只打分前 TOP_N 条候选；provider=external 时
# 客户正文出境，必须另有 CROSS_BORDER_RERANK 同意，self-hosted 才免同意。
MMS_RERANK_ENABLED_PURPOSES=CURRENT_ANSWER,HISTORY_DEBUG
MMS_RERANK_TOP_N=20
MMS_RERANKER_PROVIDER=external
# 每客户配额（docs 12.6）：计数存在库里（customer_quota_usage），超限返回 429 QUOTA_EXCEEDED；0 表示关闭该项。
MMS_QUOTA_WRITE_PER_DAY=2000
MMS_QUOTA_EXTRACTION_PER_DAY=2000
MMS_QUOTA_EMBEDDING_PER_DAY=20000
MMS_QUOTA_ACTIVE_MEMORIES=5000
# 管理面角色（docs 12.6）：X-Admin-Role 只能是这里列出的角色；改策略需要 POLICY_ADMIN_ROLES 内的角色。
MMS_ADMIN_ROLES=ADMIN,POLICY,PRIVACY,OPERATOR,READONLY
MMS_POLICY_ADMIN_ROLES=ADMIN,POLICY
# 删除请求停在 VERIFYING（WORM 账本未确认）后的重试间隔；lifecycle 会按此节流重放同一请求。
MMS_DELETION_RETRY_SECONDS=300
# 运行期账号分离（docs 12.3）：置 1 时 scripts/init_db.py 会把 schema 声明的 NOLOGIN
# 角色开成登录账号，compose 已默认启用；各进程改用 mms_app/mms_worker 等专属 DSN。
MMS_PROVISION_LOGIN_ROLES=0
MMS_APP_DB_PASSWORD=
MMS_WORKER_DB_PASSWORD=
MMS_READONLY_DB_PASSWORD=
MMS_SCRUBBER_DB_PASSWORD=
MMS_DELETION_DB_PASSWORD=
# 审计擦除使用独立账号连接（docs 6.7.5）；未设置时回退到 SET LOCAL ROLE（仅开发/测试）。
MMS_SCRUBBER_DATABASE_URL=
# 墓碑保留期清理使用独立账号连接（docs 8.3.3）；未设置时回退到 SET LOCAL ROLE（仅开发/测试）。
MMS_DELETION_DATABASE_URL=

