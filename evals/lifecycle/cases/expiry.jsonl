# 过期集（docs/4 §五.3）：T0 写入短 TTL 记忆 → T1 过期前命中 → T3 超过 TTL+传播
# SLA 后不可用（所有读取目的）→ T4 多检索入口一致。用短 TTL 代替多天等待；
# policy 声明 MMS 语义：逻辑失效对所有 purpose 生效（检索 SQL 的 expires_at 过滤）。
{"case_id": "expiry-ttl-window-001", "category": "expiry", "priority": "regular", "policy_id": "short_ttl_logical_expiry_all_purposes", "dataset_version": "1.0", "review_status": "approved", "description": "TTL 内可用，过期并执行生命周期后所有读取目的均不可用", "setup_events": [{"event_id": "e1", "text": "本周促销口令是 SPRING。", "fact_key": "campaign.promo_code", "value": "SPRING", "memory_type": "SERVICE_HISTORY", "ttl_seconds": 6, "occurred_at_offset_hours": 0}], "actions": [{"type": "wait_seconds", "seconds": 8}, {"type": "run_lifecycle"}], "assertions": [{"id": "available-before-expiry", "type": "current_fact", "phase": "setup", "query": "本周促销口令是什么", "must_contain": ["SPRING"]}, {"id": "unavailable-after-expiry", "type": "current_fact", "query": "本周促销口令是什么", "must_not_contain": ["SPRING"], "memory_count_max": 0}, {"id": "audit-also-expired", "type": "historical_fact", "query": "促销口令审计", "fact_key": "campaign.promo_code", "must_not_contain": ["SPRING"], "memory_count_max": 0}]}
{"case_id": "expiry-propagation-002", "category": "expiry", "priority": "regular", "policy_id": "expiry_propagates_all_entry_points", "dataset_version": "1.0", "review_status": "approved", "description": "过期在词法、fact_key 精确与 Agent 记忆上下文等全部检索入口一致生效", "setup_events": [{"event_id": "e1", "text": "The flash sale code today is BLAZE.", "fact_key": "campaign.flash_code", "value": "BLAZE", "memory_type": "SERVICE_HISTORY", "language": "en-US", "ttl_seconds": 6, "occurred_at_offset_hours": 0}], "actions": [{"type": "wait_seconds", "seconds": 8}, {"type": "run_lifecycle"}], "assertions": [{"id": "hit-before-expiry", "type": "current_fact", "phase": "setup", "query": "What is the flash sale code", "language": "en-US", "must_contain": ["BLAZE"]}, {"id": "miss-after-expiry-lexical", "type": "current_fact", "query": "What is the flash sale code", "language": "en-US", "must_not_contain": ["BLAZE"], "memory_count_max": 0}, {"id": "miss-after-expiry-exact", "type": "current_fact", "query": "flash sale code", "language": "en-US", "fact_key": "campaign.flash_code", "must_not_contain": ["BLAZE"], "memory_count_max": 0}, {"id": "miss-after-expiry-agent", "type": "current_fact", "query": "What is the flash sale code", "language": "en-US", "endpoint": "agent", "must_not_contain": ["BLAZE"], "memory_count_max": 0}]}
{"case_id": "expiry-rewrite-recovery-003", "category": "expiry", "priority": "regular", "policy_id": "expired_fact_rewritable", "dataset_version": "1.0", "review_status": "approved", "description": "过期后重新写入同一事实可恢复正常检索（恢复正确率）", "setup_events": [{"event_id": "e1", "text": "临时会议口令是 8848。", "fact_key": "session.meeting_code", "value": "8848", "memory_type": "SERVICE_HISTORY", "ttl_seconds": 6, "occurred_at_offset_hours": 0}], "actions": [{"type": "wait_seconds", "seconds": 8}, {"type": "run_lifecycle"}, {"type": "ingest", "event_id": "e2", "text": "新会议口令已更新为 9917。", "fact_key": "session.meeting_code", "value": "9917", "memory_type": "SERVICE_HISTORY", "explicit_correction": true}], "assertions": [{"id": "initial-available", "type": "current_fact", "phase": "setup", "query": "临时会议口令是多少", "must_contain": ["8848"]}, {"id": "recovered-after-rewrite", "type": "current_fact", "query": "临时会议口令是多少", "must_contain": ["9917"]}]}
