{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mms.local/contracts/event-envelope.schema.json",
  "title": "MMS Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "source_system",
    "customer_ref",
    "trace_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+\\.v[0-9]+$"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "customer_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "payload": {
      "type": "object"
    },
    "barrier_generation": {
      "type": "integer",
      "minimum": 0
    },
    "source_system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
